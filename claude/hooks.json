{
  "description": "Skilder entry protocol for Claude Code: one line of context at session start, and the session id init_skilder returns remembered per project for the same conversation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/claude/scripts/session-start.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__init_skilder",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/claude/scripts/remember-session.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
